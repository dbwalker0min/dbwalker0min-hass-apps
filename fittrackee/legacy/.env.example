FLASK_APP=fittrackee
FLASK_SKIP_DOTENV=1
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
UPLOAD_FOLDER=/usr/src/app/uploads
STATICMAP_CACHE_DIR=/usr/src/app/.staticmap_cache
UI_URL=http://desktop.home:3000
POSTGRES_USER=fittrackee
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=fittrackee
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@fittrackee-db:5432/${POSTGRES_DB}
GUNICORN_LOG=-
